# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Database ---
# MVP (default): SQLite file in ./data/scms.sqlite. Zero setup required.
# Production:  a full PostgreSQL connection string, e.g.
#              postgresql://postgres:password@host:5432/scms
DATABASE_URL=

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- Seed credentials (used by `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@scms.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=System Admin
SEED_USER_PASSWORD=User@12345