# Backend API base URL.
# - Default: http://localhost:5000/api  (matches the default PORT in backend/.env)
# - If port 5000 is taken on your machine (common on macOS), change the
#   backend PORT (e.g. PORT=5050) and update this URL to match:
#     VITE_API_BASE_URL=http://localhost:5050/api
VITE_API_BASE_URL=http://localhost:5000/api